+def _test_bundle_files(repository_ctx, pkg_info, target):
+    # Standalone swift_test does not assemble AppleResourceInfo into an app bundle.
+    # Materialize plain test fixtures as declared source inputs; compilation stays in Bazel.
+    if not target.resources:
+        return []
+    bundle = "_bazel_test_resources/" + pkginfo_targets.resource_bundle_name(pkg_info.name, target.c99name) + ".bundle"
+    plist = bundle + "/Info.plist"
+    repository_ctx.file(plist, '<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>CFBundlePackageType</key><string>BNDL</string></dict></plist>', executable = False)
+    result = [plist]
+    for resource in target.resources:
+        if resource.rule.embed_in_code:
+            fail("Embedded test resources need a dedicated rule: " + resource.path)
+        directory = repository_files.is_directory(repository_ctx, resource.path)
+        sources = repository_files.list_files_under(repository_ctx, resource.path, exclude_directories = True) if directory else [resource.path]
+        for source in sources:
+            if any([part.endswith((".xcassets", ".storyboard", ".xib")) for part in source.split("/")]):
+                fail("Compiled test resources need an Apple bundle test rule: " + source)
+            relative = source[len(paths.dirname(resource.path)) + 1:] if directory and resource.rule.copy else paths.basename(source)
+            destination = bundle + "/" + relative
+            if destination in result:
+                fail("Duplicate test resource: " + destination)
+            repository_ctx.symlink(repository_ctx.path(source), destination)
+            result.append(destination)
+            result.append(source)
+    return result
 
