+
+// Bazel external-package runfiles live beside _main, not under _main/external.
+private func bazelTestSourceURL(_ file: String) -> URL {
+  if let root = ProcessInfo.processInfo.environment["TEST_SRCDIR"],
+    let prefix = file.range(of: "external/")
+  {
+    return URL(fileURLWithPath: root)
+      .appendingPathComponent(String(file[prefix.upperBound...]))
+  }
+  return URL(fileURLWithPath: file)
+}
