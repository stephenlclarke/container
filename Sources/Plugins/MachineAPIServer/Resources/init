#!/bin/sh
#
# Container machine init script — replaces /sbin/init as the first process (PID 1)
# executed when a container machine boots. Performs container machine-specific setup
# before handing off to the real system init:
#
#   1. Open a user shell when invoked with the "-s" flag.
#      Looks up the current user's shell from /etc/passwd and execs into it,
#      falling back to /bin/sh. If additional arguments follow
#      "-s", runs them as a command via "<shell> -c <args>" instead of dropping
#      into an interactive session.
#
#   2. Boot the system when invoked with no flags.
#      Sets the hostname to CONTAINER_MACHINE_ID and execs /sbin/init to hand
#      off to the real system init.
#
# User setup runs separately on every boot through MachineUserSetup.swift.
#

set -e

ETC_ROOT=${CONTAINER_ETC_ROOT:-/etc}
if [ "$1" = "-s" ]; then
    shift
    USER_NAME=${CONTAINER_USER:-}
    if [ -z "${USER_NAME}" ]; then
        USER_NAME=$(id -un 2>/dev/null || true)
    fi
    USER_SHELL=
    if [ -n "${USER_NAME}" ]; then
        USER_SHELL=$(awk -F: -v user="${USER_NAME}" '$1 == user { print $7; exit }' "${ETC_ROOT}/passwd" 2>/dev/null)
    fi
    if [ $# -gt 0 ]; then
        exec "${USER_SHELL:-/bin/sh}" -c "$*"
    else
        exec "${USER_SHELL:-/bin/sh}"
    fi
else
    echo "${CONTAINER_MACHINE_ID}" > "${ETC_ROOT}/hostname"

    if [ -S ${SSH_AUTH_SOCK} ]; then
        chown ${CONTAINER_UID}:${CONTAINER_GID} ${SSH_AUTH_SOCK}
    fi

    exec /sbin/init
fi
